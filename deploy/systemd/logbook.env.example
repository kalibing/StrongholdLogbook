# 复制到 /etc/logbook/logbook.env，权限 600、属主 root（systemd 以 root 读取后再降权启动服务）
#   sudo install -m 600 -o root -g root deploy/systemd/logbook.env.example /etc/logbook/logbook.env

# 浏览器实际访问的源（HTTPS 域名，不带路径）；写请求会校验 Origin
PUBLIC_ORIGIN=https://logbook.example.com

# 存储后端二选一 ------------------------------------------------------------
# A. PostgreSQL（推荐）
LOGBOOK_DB=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=logbook
POSTGRES_DB=logbook
POSTGRES_PASSWORD=
# B. SQLite 单文件（StateDirectory 会创建 /var/lib/logbook，权限 700）
# LOGBOOK_DB=sqlite
# LOGBOOK_SQLITE=/var/lib/logbook/logbook.sqlite3

# 凭据加密密钥（URL-safe Base64 的 32 字节）：
#   python3 -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# PostgreSQL 必填；SQLite 留空时会在数据库旁生成 .credentials.key
LOGBOOK_CREDENTIAL_KEY=

# 可选：昨日战报 AI 分析
# LOGBOOK_AI_ENDPOINT=
# LOGBOOK_AI_MODEL=
# LOGBOOK_AI_API_KEY=

# 网页注册：off（默认，只能命令行建号）| open（开放注册）
# 账号由用户自己定，密码由服务端随机生成并在页面上显示一次。QQ 机器人渠道按 openid 建号，不受此开关影响。
# LOGBOOK_REGISTRATION=off

# 可选：战报图片字体（Debian/Ubuntu 装 fonts-noto-cjk 后无需设置）
# LOGBOOK_CARD_FONT=
# LOGBOOK_CARD_FONT_BOLD=

# 可选：QQ 官方机器人（单聊发「登录」获取一次性免密登录链接）
# 回调地址填 https://你的域名/qqbot/webhook
# QQBOT_APP_ID=
# QQBOT_APP_SECRET=
