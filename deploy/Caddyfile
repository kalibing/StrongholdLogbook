# Docker Compose 与 Linux 裸机共用这一份配置，差异全部走环境变量：
#   SITE_ADDRESS   站点地址；写域名（如 logbook.example.com）时 Caddy 自动申请 HTTPS 证书
#   API_UPSTREAM   FastAPI 地址；Compose 里是 api:8000，裸机 systemd 部署是 127.0.0.1:8000
#   SITE_ROOT      前端构建产物目录；Compose 镜像里是 /srv，裸机默认 /var/www/logbook
#   QQBOT_UPSTREAM QQ 机器人回调服务；Compose 里是 qqbot:8001，裸机是 127.0.0.1:8001
{$SITE_ADDRESS:http://localhost} {
  encode zstd gzip

  # 兜底的请求体上限，比后端最大的导入接口（8 MB）略宽；后端自身也有同样的限制。
  request_body {
    max_size 10MB
  }

  header {
    -Server
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Cross-Origin-Opener-Policy same-origin
    Cross-Origin-Resource-Policy same-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    # 只在 HTTPS 下生效，浏览器会忽略 HTTP 响应里的这个头。
    Strict-Transport-Security "max-age=31536000"
    # Naive UI 运行时注入 <style>，因此样式需要 'unsafe-inline'；脚本只允许同源文件。
    # 成就页的头像、名片缺图时回落到鹰角 CDN（web.hycdn.cn）。
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://web.hycdn.cn; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
  }

  handle /api/* {
    reverse_proxy {$API_UPSTREAM:api:8000}
  }

  # QQ 机器人回调（POST /qqbot/webhook）。只转发这一个路径，其余 /qqbot/* 一律 404。
  # 机器人服务没启动时这里返回 502，不影响站点其他部分。
  handle /qqbot/webhook {
    request_body {
      max_size 64KB
    }
    reverse_proxy {$QQBOT_UPSTREAM:qqbot:8001}
  }
  handle /qqbot/* {
    respond 404
  }

  @retired_login path /hg /hg/*
  handle @retired_login {
    respond 404
  }

  # 本机助手 exe 不进镜像，部署时放进宿主机目录（见 README「Linux 服务器部署」）。
  # 文件缺失时返回 404，而不是把 index.html 当成 exe 下发。
  handle /download/* {
    root * {$SITE_ROOT:/srv}
    header Content-Disposition attachment
    header Cache-Control "no-cache"
    file_server
  }

  handle {
    root * {$SITE_ROOT:/srv}
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @pages not path /assets/*
    header @pages Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }
}
