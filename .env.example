# 必填。为生产环境生成一个随机且唯一的 PostgreSQL 密码。
POSTGRES_PASSWORD=
# PostgreSQL 部署必填。使用 URL-safe Base64 编码的 32 字节随机密钥。
LOGBOOK_CREDENTIAL_KEY=
# 对外访问的站点地址（Caddy 用它申请证书）；本地测试保持 http://localhost。
SITE_ADDRESS=http://localhost
# 浏览器实际访问的源，必须与 SITE_ADDRESS 同源；写请求会校验 Origin。
PUBLIC_ORIGIN=http://localhost:8080
# 只在指定网卡上发布端口，默认仅本机可访问。
HOST_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# 存储后端（默认 postgres）。裸机/本地可切到 SQLite 单文件。
# LOGBOOK_DB=sqlite
# LOGBOOK_SQLITE=./.local/logbook.sqlite3

# 可选。配置兼容 Chat Completions 的完整接口地址和模型名后，昨日战报可按需生成 AI 分析。
# LOGBOOK_AI_ENDPOINT=https://你的服务地址/v1/chat/completions
# LOGBOOK_AI_MODEL=
# LOGBOOK_AI_API_KEY=

# 网页注册：off（默认，只能命令行建号）| open（开放注册）
# 账号由用户自己定，密码由服务端随机生成并在页面上显示一次。QQ 机器人渠道按 openid 建号，不受此开关影响。
# LOGBOOK_REGISTRATION=off

# 可选：QQ 官方机器人（单聊发「登录」获取一次性免密登录链接）
# 回调地址填 https://你的域名/qqbot/webhook
# QQBOT_APP_ID=
# QQBOT_APP_SECRET=

# 可选：方舟公告 / B 站官号动态推送（feeds 服务，随 --profile qqbot 启动）
# B 站登录：@机器人 发「B站状态」扫码即可（加密存库，qqbot / feeds 都需要 LOGBOOK_CREDENTIAL_KEY）。
# 也可以手动填 Cookie（至少含 SESSDATA 和 buvid3），库里没有扫码登录态时才使用
# BILIBILI_COOKIE=
# 密集轮询时段（北京时间），时段内整点前后 :58–:05 会更密
# FEED_BUSY_HOURS=10-18
# 推送里附原文链接（链接域名需在 QQ 开放平台配置过，否则消息会发不出）
# FEED_LINKS=0
